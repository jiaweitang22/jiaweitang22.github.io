---
import BaseHead from "../components/BaseHead.astro";
import SideBar from "../components/SideBar.astro";
import Icon from "../components/Icon.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  sideBarActiveItemID,
  breadcrumb = [],
  ogType,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
  </head>
  <body>
    <div class="app" id="app">
      <SideBar sideBarActiveItemID={sideBarActiveItemID} />
      <div class="scrim" data-nav-close aria-hidden="true"></div>

      <div class="main">
        <header class:list={["topbar", { "topbar-empty": breadcrumb.length === 0 }]}>
          <button class="menu-button" type="button" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
            <Icon name="menu" size={18} />
          </button>
          {
            breadcrumb.length > 0 && (
              <nav class="breadcrumb" aria-label="Breadcrumb">
                <a href="/">Home</a>
                {breadcrumb.map((crumb) => (
                  <>
                    <span class="slash" aria-hidden="true">/</span>
                    <span class="crumb crumb-current" aria-current="page">{crumb}</span>
                  </>
                ))}
              </nav>
            )
          }
        </header>

        <main class:list={["page", { "no-cover": !Astro.slots.has("cover") }]}>
          <slot name="cover" />
          <slot />
        </main>
      </div>
    </div>

    <script>
      const app = document.getElementById("app")!;
      const button = document.querySelector<HTMLButtonElement>(".menu-button")!;

      function setOpen(open: boolean) {
        app.classList.toggle("nav-open", open);
        button.setAttribute("aria-expanded", String(open));
        button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      }

      button.addEventListener("click", () => setOpen(!app.classList.contains("nav-open")));
      document.querySelector("[data-nav-close]")!.addEventListener("click", () => setOpen(false));

      // Copy the email address instead of relying on a mailto: handler being set up;
      // fall back to mailto: if the clipboard isn't available
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((el) => {
        const label = el.querySelector("[data-copy-label]")!;
        const original = label.textContent;
        let timer: number | undefined;
        el.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(el.dataset.copy!);
          } catch {
            window.location.href = el.dataset.href!;
            return;
          }
          label.textContent = "Email copied";
          el.dataset.copied = "";
          clearTimeout(timer);
          timer = window.setTimeout(() => {
            label.textContent = original;
            delete el.dataset.copied;
          }, 2000);
        });
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && app.classList.contains("nav-open")) {
          setOpen(false);
          button.focus();
        }
      });
    </script>
  </body>
</html>

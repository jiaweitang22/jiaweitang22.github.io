---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  sideBarActiveItemID,
  breadcrumb = [],
  ogType,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
  </head>
  <body>
    <div class="app">
      <input id="nav-toggle" class="nav-toggle" type="checkbox" aria-hidden="true" tabindex="-1" />
      <SideBar sideBarActiveItemID={sideBarActiveItemID} />
      <label for="nav-toggle" class="scrim" aria-hidden="true"></label>

      <div class="main">
        <header class="topbar">
          <label for="nav-toggle" class="menu-button" aria-label="Open menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
              ><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path></svg
            >
          </label>
          <nav class="breadcrumb" aria-label="Breadcrumb">
            {
              breadcrumb.length === 0 ? (
                <span class="crumb crumb-current">🏠 Jiawei Tang</span>
              ) : (
                <>
                  <a href="/">🏠 Jiawei Tang</a>
                  {breadcrumb.map((crumb) => (
                    <>
                      <span class="slash">/</span>
                      <span class="crumb crumb-current">{crumb}</span>
                    </>
                  ))}
                </>
              )
            }
          </nav>
        </header>

        <slot name="cover" />
        <main class:list={["page", { "no-cover": !Astro.slots.has("cover") }]}>
          <slot />
          <Footer />
        </main>
      </div>
    </div>
  </body>
</html>

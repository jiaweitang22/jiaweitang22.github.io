---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryCard from "../components/GalleryCard.astro";
import Icon from "../components/Icon.astro";
import { projects } from "../data/projects";
import { LINKS } from "../config";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="cover" slot="cover">
    <img src="/cover.jpg" alt="Sather Tower and Doe Library seen from Memorial Glade at UC Berkeley" />
  </div>

  <img class="page-icon" src="/profile.jpg" alt="Jiawei Tang" width="124" height="124" />
  <h1 class="page-title">Jiawei Tang</h1>
  <p class="page-subtitle">Software Engineer at Samsara · UC Berkeley EECS ’26</p>

  <div class="link-row">
    {
      LINKS.map((link) => {
        const external = !link.href.startsWith("mailto:");
        return (
          <a class="link-pill" href={link.href} target={external ? "_blank" : undefined} rel={external ? "noreferrer" : undefined}>
            <Icon name={link.icon} size={15} />
            {link.label}
          </a>
        );
      })
    }
  </div>

  <hr class="divider" />

  <p>
    I recently graduated from the University of California, Berkeley with a bachelor’s degree in Electrical
    Engineering and Computer Sciences, and I’m now a software engineer at Samsara. Below is a selection of my work in
    computer vision and computational photography.
  </p>

  <div class="db-header">
    <h2 class="db-title">Latest projects</h2>
    <a class="db-action" href="/projects">
      View all {projects.length}
      <Icon name="arrow-right" size={14} />
    </a>
  </div>
  <div class="gallery gallery-3">
    {projects.slice(0, 3).map((project) => <GalleryCard {...project} />)}
  </div>
</BaseLayout>

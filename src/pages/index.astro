---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Jiawei Tang</div>
    <div class="text-3xl py-3 font-bold">Software Engineer @ Samsara</div>
    <div class="py-2">
      <text class="text-lg">
        Welcome to my website. I'm a software engineer at Samsara, and I'm also interested in computer vision,
        computational photography, and machine learning. This is where I keep my project write-ups, from colorizing
        century-old photographs to training flow models.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="mailto:jiaweitang22@gmail.com">Let's connect!</a>
      <a href="https://github.com/jiaweitang22" target="_blank" class="btn btn-outline ml-5">GitHub</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">My latest projects {"</>"}</div>
  </div>

  {
    projects.slice(0, 3).map((project) => (
      <>
        <HorizontalCard {...project} />
        <div class="divider my-0" />
      </>
    ))
  }
  <a href="/projects" class="btn btn-outline mt-4">See all projects</a>
</BaseLayout>

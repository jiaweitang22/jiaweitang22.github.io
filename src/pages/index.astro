---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Jiawei Tang</div>
    <div class="text-3xl pt-3 font-bold">Software Engineer @ Samsara</div>
    <div class="text-xl pb-3 opacity-75">UC Berkeley EECS '26</div>
    <div class="py-2">
      <text class="text-lg">
        Welcome to my website. I'm a software engineer at Samsara. I studied EECS at UC Berkeley, and along the way I interned at Samsara, TikTok, AWS, and Viridien and
        did research at MIT. I also love computational photography; my project write-ups are below.
      </text>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn" href="https://www.linkedin.com/in/jiaweitang22" target="_blank">Let's connect!</a>
      <a href="/cv" class="btn btn-outline">CV</a>
      <a href="https://github.com/jiaweitang22" target="_blank" class="btn btn-outline">GitHub</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">My latest projects {"</>"}</div>
  </div>

  {
    projects.slice(0, 3).map((project) => (
      <>
        <HorizontalCard {...project} />
        <div class="divider my-0" />
      </>
    ))
  }
  <a href="/projects" class="btn btn-outline mt-4">See all projects</a>
</BaseLayout>

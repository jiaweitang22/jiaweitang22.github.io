---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">CS 180: Computer Vision &amp; Computational Photography</div>
  </div>

  {
    projects.map((project, i) => (
      <>
        <HorizontalCard {...project} />
        {i < projects.length - 1 && <div class="divider my-0" />}
      </>
    ))
  }
</BaseLayout>

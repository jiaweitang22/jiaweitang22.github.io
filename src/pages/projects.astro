---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryCard from "../components/GalleryCard.astro";
import Icon from "../components/Icon.astro";
import { projects, tagColor } from "../data/projects";
---

<BaseLayout title="Projects · Jiawei Tang" sideBarActiveItemID="projects" breadcrumb={["Projects"]}>
  <h1 class="page-title">Projects</h1>
  <p class="page-subtitle">
    Write-ups from CS 180: Computer Vision &amp; Computational Photography at UC Berkeley. Each one opens the full
    project page.
  </p>

  <input class="view-radio" type="radio" name="view" id="view-gallery" checked />
  <input class="view-radio" type="radio" name="view" id="view-table" />

  <div class="db-header">
    <h2 class="db-title">CS 180</h2>
    <div class="db-views" role="group" aria-label="View">
      <label class="db-view" for="view-gallery"><Icon name="projects" size={14} /> Gallery</label>
      <label class="db-view" for="view-table"><Icon name="list" size={14} /> Table</label>
    </div>
  </div>

  <div class="db-body-gallery">
    <div class="gallery">
      {projects.map((project) => <GalleryCard {...project} />)}
    </div>
  </div>

  <div class="db-body-table">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Project</th>
            <th scope="col">Summary</th>
            <th scope="col">Topics</th>
          </tr>
        </thead>
        <tbody>
          {
            projects.map((project) => (
              <tr>
                <td class="name-cell">
                  <a href={project.url} target="_blank" rel="noreferrer">
                    {project.title}
                  </a>
                </td>
                <td>{project.desc}</td>
                <td>
                  <div class="tags-cell">
                    {project.tags.map((tag) => (
                      <span class:list={["tag", tagColor(tag)]}>{tag}</span>
                    ))}
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</BaseLayout>

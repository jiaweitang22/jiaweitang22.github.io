  /* Chart */
  .wu-chart { position: relative; }
  .wu-chart svg { display: block; width: 100%; overflow: visible; }
  .wu-chart .grid line { stroke: var(--divider); }
  .wu-chart .axis text { fill: var(--text-faint); font: 11px var(--font); }
  .wu-chart .series path { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .wu-chart .direct { font: 500 12px var(--font); fill: var(--text-muted); }

    border-bottom: 1px solid var(--divider);
  }
  .wu-table tr:first-child th,
  .wu-table tr:first-child td {
    border-top: 1px solid var(--divider);
  }
  .wu-api td:first-child {
    width: 46%;
  }
  .wu-api .wu-api-group th {
    padding-top: 16px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    border-left: 0;

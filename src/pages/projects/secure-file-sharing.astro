    background: var(--sidebar-bg);
  }
  .wu-result.ok { background: var(--tag-green); color: var(--text); }
  .wu-result.err { background: var(--tag-red); color: var(--text); }
  .wu-entries {
    list-style: none;
    padding: 6px;
    border-radius: 4px;
    background: var(--sidebar-bg);
    font: 12px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--text-muted);
  }
  .wu-entries li {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 10px;
    padding: 0 6px;
    border-radius: 3px;
    white-space: nowrap;
  }
  .wu-entries .v {

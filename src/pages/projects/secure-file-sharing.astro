    position: absolute;
    left: 100%;
    width: 1px;
    height: 46px;
    background: var(--divider);
  }
  .wu-arch-link::before { bottom: 0; }
  .wu-arch-link::after { top: 0; }
  .wu-node {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 12px;
    border: 1px solid var(--divider);

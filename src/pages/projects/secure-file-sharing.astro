    .wu-arch-link::after { display: none; }
    .wu-sim { grid-template-columns: 1fr; }
    .wu-props > div { grid-template-columns: 96px 1fr; }
    .wu-api td:first-child { width: auto; }
    .wu-api td code { white-space: normal; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const HEX = "0123456789abcdef";
  const randHex = (n: number) => Array.from({ length: n }, () => HEX[(Math.random() * 16) | 0]).join("");

  // ---------- Banner: shimmering ciphertext ----------
  {
    const field = document.getElementById("wu-hex")!;
    const cells: HTMLSpanElement[] = [];
    for (let i = 0; i < 900; i++) {
      const s = document.createElement("span");
      s.textContent = randHex(2);
      field.appendChild(s);
      cells.push(s);
    }
    if (!reduceMotion) {
      setInterval(() => {
        for (let i = 0; i < 10; i++) {
          const c = cells[(Math.random() * cells.length) | 0];
          c.textContent = randHex(2);
          c.classList.add("on");
          setTimeout(() => c.classList.remove("on"), 60);
        }
      }, 90);
    }
  }

  // ---------- Tamper demo ----------
  {
    const root = document.getElementById("wu-sim")!;
    const list = root.querySelector<HTMLOListElement>("[data-sim-entries]")!;
    const result = root.querySelector<HTMLDivElement>("[data-sim-result]")!;
    const body = root.querySelector<HTMLDivElement>("[data-sim-body]")!;
    const size = new TextEncoder().encode(body.textContent ?? "").length;
    type Entry = { k: string; v: string; hit?: boolean; dead?: boolean };
    let entries: Entry[] = [];
    let tampered = false;

    const idle = "Datastore is unmodified.";
    const setResult = (cls: string, text: string) => {
      result.className = "wu-result " + cls;
      result.textContent = text;
    };
    const fresh = () => {
      entries = Array.from({ length: 8 }, () => ({ k: randHex(8), v: randHex(64) }));
      tampered = false;
      body.classList.remove("gone");
      setResult("", idle);
    };
    const render = () => {
      list.innerHTML = "";
      for (const e of entries) {
        const li = document.createElement("li");
        li.className = (e.hit ? "hit " : "") + (e.dead ? "dead" : "");
        li.innerHTML = `<span>${e.k}</span><span class="v">${e.v}</span>`;
        list.appendChild(li);
      }
    };

    root.querySelector("[data-sim-load]")!.addEventListener("click", () => {
      if (tampered) {
        body.classList.add("gone");
        setResult("err", "error: file could not be verified");
      } else {
        body.classList.remove("gone");
        setResult("ok", `ok: ${size} bytes`);
      }
    });

    root.querySelectorAll<HTMLButtonElement>("[data-sim-attack]").forEach((b) =>
      b.addEventListener("click", () => {
        entries.forEach((e) => (e.hit = false));
        const live = entries.filter((e) => !e.dead);
        if (live.length < 2) return;
        const a = live[(Math.random() * live.length) | 0];
        const kind = b.dataset.simAttack;
        if (kind === "flip") {
          const i = (Math.random() * a.v.length) | 0;
          const flipped = (parseInt(a.v[i], 16) ^ (1 << ((Math.random() * 4) | 0))).toString(16);
          a.v = a.v.slice(0, i) + flipped + a.v.slice(i + 1);
        } else if (kind === "swap") {
          let other = a;
          while (other === a) other = live[(Math.random() * live.length) | 0];
          [a.v, other.v] = [other.v, a.v];
          other.hit = true;
        } else {
          a.dead = true;
        }
        a.hit = true;
        tampered = true;
        render();
        setResult("", "Datastore modified. Load the file to see what happens.");
      })
    );

    root.querySelector("[data-sim-reset]")!.addEventListener("click", () => {
      fresh();
      render();
    });

    fresh();
    render();
  }

  // ---------- Share tree stepper ----------
  {
    const root = document.getElementById("wu-tree")!;
    type S = "hidden" | "pending" | "active" | "revoked";
    const users = ["alice", "bob", "doris", "charles", "eve"] as const;
    const steps: { call: string; text: string; nodes: Partial<Record<(typeof users)[number], S>> }[] = [
      {
        call: 'alice.StoreFile("plans.txt", data)',
        text: "Alice creates a file. She is its owner and the root of its share tree.",
        nodes: { alice: "active" },
      },
      {
        call: 'inv := alice.CreateInvitation("plans.txt", "bob")',
        text: "Alice invites Bob. Until he accepts he can't read the file, and he has to be able to verify that the invitation came from Alice.",
        nodes: { alice: "active", bob: "pending" },
      },
      {
        call: 'bob.AcceptInvitation("alice", inv, "mission.txt")',
        text: "Bob accepts under his own filename. It's the same file as Alice's plans.txt.",
        nodes: { alice: "active", bob: "active" },
      },
      {
        call: 'alice shares with doris, who names it "notes.txt"\nbob shares with charles, who names it "copy.txt"\ndoris shares with eve, who names it "plan-b.txt"',
        text: "Anyone with access can share further. Charles got the file from Bob, not from Alice.",
        nodes: { alice: "active", bob: "active", doris: "active", charles: "active", eve: "active" },
      },
      {
        call: 'charles.AppendToFile("copy.txt", update)',
        text: "There is one copy of the file, so everyone sees Charles's change on their next load, on any device.",
        nodes: { alice: "active", bob: "active", doris: "active", charles: "active", eve: "active" },
      },
      {
        call: 'alice.RevokeAccess("plans.txt", "bob")',
        text: "Alice revokes Bob. Bob and Charles lose access. Doris and Eve keep it without accepting anything again.",
        nodes: { alice: "active", bob: "revoked", doris: "active", charles: "revoked", eve: "active" },
      },
      {
        call: 'bob.LoadFile("mission.txt")   // error\neve.LoadFile("plan-b.txt")    // latest contents',
        text: "Bob and Charles may still have old data and may read storage directly. They learn nothing about later contents, and any change they make is detected.",
        nodes: { alice: "active", bob: "revoked", doris: "active", charles: "revoked", eve: "active" },
      },
    ];

    let i = 0;
    const call = root.querySelector<HTMLElement>("[data-tree-call]")!;
    const text = root.querySelector<HTMLElement>("[data-tree-text]")!;
    const idx = root.querySelector<HTMLElement>("[data-tree-index]")!;
    root.querySelector<HTMLElement>("[data-tree-total]")!.textContent = String(steps.length);
    const prev = root.querySelector<HTMLButtonElement>("[data-tree-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-tree-next]")!;

    const draw = () => {
      const s = steps[i];
      call.textContent = s.call;
      text.textContent = s.text;
      idx.textContent = String(i + 1);
      for (const u of users) {
        const state = s.nodes[u] ?? "hidden";
        root.querySelector<SVGGElement>(`[data-node="${u}"]`)!.dataset.state = state;
        const edge = root.querySelector<SVGPathElement>(`[data-edge="${u}"]`);
        if (edge) edge.dataset.state = state;
      }
      prev.disabled = i === 0;
      next.disabled = i === steps.length - 1;
    };

    prev.addEventListener("click", () => { if (i > 0) { i--; draw(); } });
    next.addEventListener("click", () => { if (i < steps.length - 1) { i++; draw(); } });
    draw();
  }

  // ---------- Append cost chart ----------
  {
    // Bandwidth relative to the same operation on a 2 KB file
    const data = [
      { kb: 2, append: 1, load: 1 },
      { kb: 4, append: 1, load: 1.83 },
      { kb: 8, append: 1, load: 3.49 },
      { kb: 16, append: 1, load: 6.8 },
      { kb: 32, append: 1, load: 13.44 },
      { kb: 64, append: 1, load: 26.7 },
      { kb: 128, append: 1, load: 53.24 },
      { kb: 256, append: 1, load: 106.31 },
      { kb: 512, append: 1, load: 212.44 },
      { kb: 1024, append: 1, load: 424.71 },
    ];
    const label = (kb: number) => (kb >= 1024 ? `${kb / 1024} MB` : `${kb} KB`);
    const fmt = (x: number) => (x < 10 ? parseFloat(x.toFixed(2)) : Math.round(x)) + "×";

    const tbody = document.querySelector<HTMLTableSectionElement>("[data-chart-table] tbody")!;
    tbody.innerHTML = data.map((d) => `<tr><td>${label(d.kb)}</td><td>${fmt(d.append)}</td><td>${fmt(d.load)}</td></tr>`).join("");

    const host = document.getElementById("wu-chart")!;
    const NS = "http://www.w3.org/2000/svg";
    const el = (tag: string, attrs: Record<string, string | number> = {}, parent?: Element) => {
      const n = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
      parent?.appendChild(n);
      return n;
    };
    const series = [
      { key: "append" as const, color: "var(--focus)", name: "Append" },
      { key: "load" as const, color: "var(--text-muted)", name: "Load" },
    ];

    let lastW = 0;
    const render = () => {
      const W = host.clientWidth;
      if (W === lastW) return;
      lastW = W;
      host.innerHTML = "";
      const narrow = W < 480;
      const H = narrow ? 220 : 260;
      const m = { t: 10, r: 92, b: 28, l: 44 };
      const iw = W - m.l - m.r;
      const ih = H - m.t - m.b;
      const x = (kb: number) => m.l + (Math.log2(kb / 2) / Math.log2(512)) * iw;
      const y = (v: number) => m.t + ih - (Math.log10(v / 0.5) / Math.log10(1000 / 0.5)) * ih;

      const svg = el("svg", { viewBox: `0 0 ${W} ${H}`, height: H, role: "img", "aria-label": "AppendToFile stays at 1× while LoadFile grows to 425× as the file grows from 2 KB to 1 MB" }, host);
      const grid = el("g", { class: "grid" }, svg);
      const axis = el("g", { class: "axis" }, svg);
      for (const v of [1, 10, 100, 1000]) {
        el("line", { x1: m.l, x2: m.l + iw, y1: y(v), y2: y(v) }, grid);
        el("text", { x: m.l - 8, y: y(v) + 4, "text-anchor": "end" }, axis).textContent = `${v}×`;
      }
      for (const kb of narrow ? [2, 32, 1024] : [2, 8, 32, 128, 512]) {
        el("text", { x: x(kb), y: m.t + ih + 18, "text-anchor": "middle" }, axis).textContent = label(kb);
      }

      for (const s of series) {
        const g = el("g", { class: "series" }, svg);
        el("path", { d: data.map((d, j) => `${j ? "L" : "M"}${x(d.kb)},${y(d[s.key])}`).join(""), stroke: s.color }, g);
        const last = data[data.length - 1];
        el("text", { class: "direct", x: x(last.kb) + 8, y: y(last[s.key]) + 4 }, svg).textContent = `${s.name} ${fmt(last[s.key])}`;
      }

      const cross = el("line", { class: "cross", y1: m.t, y2: m.t + ih, visibility: "hidden" }, svg);
      const dots = series.map((s) => el("circle", { r: 3.5, fill: s.color, stroke: "var(--bg)", "stroke-width": 2, visibility: "hidden" }, svg));
      const tip = document.createElement("div");
      tip.className = "wu-tip";
      tip.hidden = true;
      host.appendChild(tip);
      const hit = el("rect", { x: m.l - 10, y: 0, width: iw + 20, height: H, fill: "transparent" }, svg);
      hit.addEventListener("pointermove", (e) => {
        const px = (e as PointerEvent).clientX - host.getBoundingClientRect().left;
        let best = data[0];
        for (const d of data) if (Math.abs(x(d.kb) - px) < Math.abs(x(best.kb) - px)) best = d;
        const cx = x(best.kb);
        cross.setAttribute("x1", String(cx));
        cross.setAttribute("x2", String(cx));
        cross.setAttribute("visibility", "visible");
        series.forEach((s, j) => {
          dots[j].setAttribute("cx", String(cx));
          dots[j].setAttribute("cy", String(y(best[s.key])));
          dots[j].setAttribute("visibility", "visible");
        });
        tip.innerHTML = `<b>${label(best.kb)} file</b>` + series.map((s) => `<div>${s.name} ${fmt(best[s.key])}</div>`).join("");
        tip.hidden = false;
        tip.style.left = `${Math.min(Math.max(cx, 60), W - 60)}px`;
        tip.style.top = `${y(best.load)}px`;
      });
      hit.addEventListener("pointerleave", () => {
        tip.hidden = true;
        cross.setAttribute("visibility", "hidden");
        dots.forEach((d) => d.setAttribute("visibility", "hidden"));
      });
    };

    render();
    new ResizeObserver(() => requestAnimationFrame(render)).observe(host);
  }
</script>

    color: var(--text-faint);
  }
  .wu-entries li.hit { background: var(--tag-red); }
  .wu-entries li.hit .v { color: var(--text); }
  .wu-entries li.dead span { text-decoration: line-through; }
  .wu-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Share tree */
  .wu-tree-svg {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    margin: 0 auto;
  }
  .wu-edges path {
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 1;
    transition: opacity 250ms ease;
  }
  .wu-edges path[data-state="hidden"] { opacity: 0; }
  .wu-edges path[data-state="pending"] { stroke-dasharray: 4 4; }

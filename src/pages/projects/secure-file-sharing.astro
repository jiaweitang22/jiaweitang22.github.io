---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";

const title = "Secure File Sharing System";
const description = "A Go client library for storing and sharing files on a server that is assumed to be malicious.";

const api = [
  {
    group: "Users",
    fns: [
      { sig: "InitUser(username, password)", desc: "Create an account. Usernames are unique and case-sensitive, and any password is valid, including an empty one." },
      { sig: "GetUser(username, password)", desc: "Log in from any device. Fails on wrong credentials or if the user's stored data was tampered with." },
    ],
  },
  {
    group: "Files",
    fns: [
      { sig: "StoreFile(filename, content)", desc: "Create or overwrite a file in the caller's own namespace." },
      { sig: "LoadFile(filename)", desc: "Return the latest contents, or an error if anything the file depends on was modified." },
      { sig: "AppendToFile(filename, content)", desc: "Add bytes to the end of a file, within a bandwidth limit." },
    ],
  },
  {
    group: "Sharing",
    fns: [
      { sig: "CreateInvitation(filename, recipient)", desc: "Share a file. Anyone with access can do this, and the recipient must be able to verify the sender." },
      { sig: "AcceptInvitation(sender, invitation, filename)", desc: "Add a shared file to your namespace under a name you choose." },
      { sig: "RevokeAccess(filename, recipient)", desc: "Owner only. Removes the recipient and everyone they shared with." },
    ],
  },
];
---

<BaseLayout
  title={`${title} · Jiawei Tang`}
  description={description}
  image="/projects/cs161-proj2.svg"
  sideBarActiveItemID="projects"
  breadcrumb={[{ label: "Projects", href: "/projects" }, title]}
>
  <div class="cover wu-hero" slot="cover" aria-hidden="true">
    <div class="wu-hex" id="wu-hex"></div>
    <div class="wu-hero-fade"></div>
  </div>

  <div class="wu-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4.5" y="10.5" width="15" height="10" rx="2" />
      <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
      <path d="M12 14.5v2.5" />
    </svg>
  </div>

  <h1 class="page-title">{title}</h1>
  <p class="page-subtitle">{description}</p>

  <dl class="wu-props">
    <div><dt>Course</dt><dd>CS 161: Computer Security, UC Berkeley</dd></div>
    <div><dt>Term</dt><dd>Spring 2025</dd></div>
    <div><dt>Language</dt><dd>Go</dd></div>
    <div><dt>Topics</dt><dd class="wu-tags"><span class="tag blue">Cryptography</span><span class="tag red">Security</span></dd></div>
  </dl>

  <hr class="divider" />

  <h2 class="wu-h2">Overview</h2>
  <p>
    The server can read, modify or delete anything it stores and sees every request. The library still provides a normal file API (log in, store, load, append, share, revoke), reveals nothing about file contents or names, and returns an error instead of bad data whenever the server tampers with anything.
  </p>

  <h2 class="wu-h2">Setting</h2>
  <p>
    The client library is the only trusted code. It keeps no state between calls, since a user may be logged in on several devices that must all see the latest data. It talks to two services: Datastore, an attacker-controlled map from UUIDs to bytes that holds all data, and Keystore, a trusted, immutable map from names to public keys with a fixed number of entries per user.
  </p>

  <figure class="wu-fig wu-arch">
    <div class="wu-arch-client">
      <div class="wu-node">
        <div class="wu-node-title">Client library</div>
        <div class="wu-node-sub">One copy per device, no local state</div>
      </div>
    </div>
    <div class="wu-arch-link" aria-hidden="true"></div>
    <div class="wu-arch-services">
      <div class="wu-node">
        <div class="wu-node-head"><span class="wu-node-title">Datastore</span><span class="tag red">untrusted</span></div>
        <code class="wu-node-sub">UUID → bytes</code>
        <div class="wu-node-sub">All file and user data. Readable and writable by the attacker.</div>
      </div>
      <div class="wu-node">
        <div class="wu-node-head"><span class="wu-node-title">Keystore</span><span class="tag green">trusted</span></div>
        <code class="wu-node-sub">name → public key</code>
        <div class="wu-node-sub">Public keys only. Entries can't be changed once written.</div>
      </div>
    </div>
  </figure>

  <h2 class="wu-h2">Threat model</h2>
  <p>
    The spec defines two attackers who don't collude.
  </p>

  <h3 class="wu-h3">The Datastore</h3>
  <p>
    Can read, modify, add and delete entries between calls, diff snapshots to see what each call changed, see which user called which function, and read the source code.
  </p>

  <h3 class="wu-h3">The revoked user</h3>
  <p>
    May have saved anything seen before revocation, and can run modified client code to read or write Datastore directly. Must not learn later contents, and any change must be detected.
  </p>

  <div class="table-wrap">
    <table class="table wu-table">
      <tbody>
        <tr><th scope="row">Kept secret</th><td>File contents, filenames, filename lengths, keys</td></tr>
        <tr><th scope="row">Allowed to leak</th><td>Usernames, file sizes, the number of users and files</td></tr>
        <tr><th scope="row">Must be detected</th><td>Any modification, deletion or substitution of data the client relies on</td></tr>
      </tbody>
    </table>
  </div>

  <p>
    Tamper with the store on the right, then load the file. The client returns either the correct file or an error.
  </p>

  <figure class="wu-fig wu-sim" id="wu-sim">
    <div class="wu-sim-pane">
      <div class="wu-label">Alice's client</div>
      <div class="wu-file">
        <code class="wu-file-name">notes.txt</code>
        <div class="wu-file-body" data-sim-body>Meeting moved to Thursday.</div>
      </div>
      <button class="link-pill wu-btn" type="button" data-sim-load><code>LoadFile("notes.txt")</code></button>
      <div class="wu-result" data-sim-result role="status" aria-live="polite"></div>
    </div>
    <div class="wu-sim-pane">
      <div class="wu-label">Datastore, as the attacker sees it</div>
      <ol class="wu-entries" data-sim-entries></ol>
      <div class="wu-actions">
        <button class="link-pill wu-btn" type="button" data-sim-attack="flip">Flip a bit</button>
        <button class="link-pill wu-btn" type="button" data-sim-attack="swap">Swap two entries</button>
        <button class="link-pill wu-btn" type="button" data-sim-attack="delete">Delete an entry</button>
        <button class="link-pill wu-btn" type="button" data-sim-reset>Reset</button>
      </div>
    </div>
    <figcaption>Illustration only. Entries are random bytes, not the real storage layout.</figcaption>
  </figure>

  <h2 class="wu-h2">API</h2>
  <p>
    Eight functions, each with defined success and error conditions.
  </p>

  <div class="table-wrap">
    <table class="table wu-table wu-api">
      <tbody>
        {
          api.map((g) => (
            <>
              <tr class="wu-api-group"><th colspan="2" scope="colgroup">{g.group}</th></tr>
              {g.fns.map((f) => (
                <tr>
                  <td><code>{f.sig}</code></td>
                  <td>{f.desc}</td>
                </tr>
              ))}
            </>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 class="wu-h2">Sharing and revocation</h2>
  <p>
    Anyone with access can share a file, so access forms a tree rooted at the owner. All users work on one copy, each under their own filename, and see each other's changes on the next load. Only the owner can revoke. Revoking a user also removes everyone they shared with, without affecting anyone else. This is the hardest requirement, since a revoked user keeps everything they saw and can bypass the client.
  </p>

  <figure class="wu-fig wu-tree" id="wu-tree">
    <svg class="wu-tree-svg" viewBox="78 18 444 264" role="img" aria-labelledby="wu-tree-caption">
      <g class="wu-edges">
        <path data-edge="bob" d="M300 62 L150 150" />
        <path data-edge="doris" d="M300 62 L450 150" />
        <path data-edge="charles" d="M150 150 L150 240" />
        <path data-edge="eve" d="M450 150 L450 240" />
      </g>
      <g class="wu-nodes">
        <g data-node="alice" transform="translate(300 52)">
          <rect x="-62" y="-26" width="124" height="52" rx="6" />
          <text class="wu-n-name" y="-3">Alice (owner)</text>
          <text class="wu-n-file" y="15">plans.txt</text>
        </g>
        <g data-node="bob" transform="translate(150 150)">
          <rect x="-62" y="-26" width="124" height="52" rx="6" />
          <text class="wu-n-name" y="-3">Bob</text>
          <text class="wu-n-file" y="15">mission.txt</text>
        </g>
        <g data-node="doris" transform="translate(450 150)">
          <rect x="-62" y="-26" width="124" height="52" rx="6" />
          <text class="wu-n-name" y="-3">Doris</text>
          <text class="wu-n-file" y="15">notes.txt</text>
        </g>
        <g data-node="charles" transform="translate(150 248)">
          <rect x="-62" y="-26" width="124" height="52" rx="6" />
          <text class="wu-n-name" y="-3">Charles</text>
          <text class="wu-n-file" y="15">copy.txt</text>
        </g>
        <g data-node="eve" transform="translate(450 248)">
          <rect x="-62" y="-26" width="124" height="52" rx="6" />
          <text class="wu-n-name" y="-3">Eve</text>
          <text class="wu-n-file" y="15">plan-b.txt</text>
        </g>
      </g>
    </svg>

    <div class="wu-tree-panel">
      <code class="wu-call" data-tree-call></code>
      <p class="wu-tree-text" id="wu-tree-caption" data-tree-text aria-live="polite"></p>
      <div class="wu-tree-nav">
        <button class="link-pill wu-btn" type="button" data-tree-prev><Icon name="arrow-left" size={14} /> Back</button>
        <span class="wu-step"><span data-tree-index>1</span> of <span data-tree-total>7</span></span>
        <button class="link-pill wu-btn" type="button" data-tree-next>Next <Icon name="arrow-right" size={14} /></button>
      </div>
    </div>
  </figure>

  <h2 class="wu-h2">Append cost</h2>
  <p>
    Append bandwidth may grow with the size of the appended data, but not with the file size or the number of earlier appends. In a benchmark that grows a file from 2 KB to 1 MB in 1 KB appends, measured with the course's bandwidth counter, append cost stays constant while loading the whole file grows 425×.
  </p>

  <figure class="wu-fig wu-chart-fig">
    <div class="wu-chart" id="wu-chart"></div>
    <figcaption>
      Bandwidth relative to the same operation on a 2 KB file. Both axes are logarithmic.
      <details class="wu-details">
        <summary>Data table</summary>
        <table class="table wu-table" data-chart-table>
          <thead><tr><th scope="col">File size</th><th scope="col">AppendToFile</th><th scope="col">LoadFile</th></tr></thead>
          <tbody></tbody>
        </table>
      </details>
    </figcaption>
  </figure>

  <h2 class="wu-h2">What I learned</h2>
  <p>
    Each primitive guarantees something narrow. CTR-mode encryption hides data but doesn't prevent bit flips. An HMAC detects changes, but only for key holders. A signature is publicly verifiable, but only as trustworthy as the binding between key and username. Most of the work was making sure no part of the design relied on a primitive for more than it provides.
  </p>
  <p>
    Writing down the threat model first turned vague concerns into specific cases to check the design against.
  </p>
  <p>
    Statelessness shaped the design as much as any security requirement. Nothing carries over between calls, so every read from storage has to be verified before use.
  </p>

  <a class="db-action back-link wu-back" href="/projects"><Icon name="arrow-left" size={14} /> All projects</a>
</BaseLayout>

<style is:global>
  /* ---------- Banner ---------- */
  .wu-hero {
    background: #0f1419;
  }
  .wu-hex {
    position: absolute;
    inset: -8px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(26px, 1fr));
    align-content: start;
    font: 500 12px/22px ui-monospace, SFMono-Regular, Menlo, monospace;
    color: rgba(150, 190, 230, 0.32);
    text-align: center;
    user-select: none;
  }
  .wu-hex span {
    transition: color 600ms ease;
  }
  .wu-hex span.on {
    color: #8cc4ff;
    transition: none;
  }
  .wu-hero-fade {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 90% at 50% 50%, rgba(15, 20, 25, 0) 0%, rgba(15, 20, 25, 0.75) 100%);
  }

  .wu-icon {
    position: relative;
    z-index: 1;
    width: 56px;
    height: 56px;
    margin-top: -28px;
    color: var(--text);
    background: var(--bg);
    border-radius: 6px;
  }

  /* ---------- Properties ---------- */
  .wu-props {
    display: grid;
    gap: 2px;
    margin-top: 16px;
    font-size: 14px;
  }
  .wu-props > div {
    display: grid;
    grid-template-columns: 120px 1fr;
    align-items: center;
    min-height: 30px;
  }
  .wu-props dt {
    color: var(--text-muted);
  }
  .wu-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  /* ---------- Type ---------- */
  .wu-h2 {
    margin: 40px 0 4px;
    font-size: 20px;
    font-weight: 600;
  }
  .wu-h3 {
    margin: 20px 0 2px;
    font-size: 16px;
    font-weight: 600;
  }
  .page code {
    padding: 1px 4px;
    border-radius: 4px;
    background: var(--hover);
    color: var(--text);
    font: 85% ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  /* ---------- Figures ---------- */
  .wu-fig {
    margin: 16px 0 8px;
    padding: 16px;
    border-radius: 6px;
    box-shadow: var(--card-shadow);
    background: var(--bg);
  }
  .wu-fig figcaption {
    margin-top: 12px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .wu-label {
    font-size: 13px;
    color: var(--text-muted);
  }
  .page .wu-btn {
    height: 28px;
    padding: 0 10px;
    font-size: 13px;
  }
  .page .wu-btn code {
    padding: 0;
    background: none;
  }
  .wu-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* Architecture */
  .wu-arch {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 40px minmax(0, 1.3fr);
    align-items: center;
  }
  .wu-arch-services {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .wu-arch-link {
    height: 1px;
    background: var(--divider);
    position: relative;
  }
  .wu-arch-link::before,
  .wu-arch-link::after {

---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";

const experience = [
  {
    title: "Software Engineer at Samsara",
    subtitle: "Full-time · present",
    points: [],
  },
  {
    title: "SWE Intern at Samsara",
    subtitle: "May to Aug 2026 · San Francisco, CA",
    points: [
      "Architected a DINOv3 computer-vision classifier that replaced a production vision-LLM for cargo-theft detection, raising accuracy from 84% to 98% and cutting missed thefts by ~90%.",
      "Built a reusable ML framework for computer-vision apps, unifying multi-GPU training (Ray Train) and autoscaling, request-batched serving (Ray Serve); reduced latency ~10x from 7.6s to sub-second and cut per-prediction cost ~99% by moving from paid API calls to local inference.",
      "Shipped three production vision models (door state, fill level, and cargo shift) enabling theft detection, load optimization, and damage/insurance workflows on a low-cost camera platform.",
    ],
  },
  {
    title: "SWE Intern at TikTok",
    subtitle: "Jan to May 2026 · San Jose, CA",
    points: [
      "Developed backend infrastructure for AI-powered creative agents in TikTok Symphony's Creative Studio, enabling advertisers to auto-generate video concepts and drafts and supporting the MVP launch.",
      "Architected MCP-based backend services for multi-step video generation, handling 100 requests/second with asynchronous workflows, fault-tolerant retries, and secure cross-service integrations.",
    ],
  },
  {
    title: "SDE Intern at Amazon Web Services",
    subtitle: "May to Aug 2025 · Seattle, WA",
    points: [
      "Implemented an automated monitoring dashboard for model availability, usage metrics, and deployment tracking across Bedrock Marketplace and SageMaker JumpStart, supporting 1,000+ models across 37 AWS commercial regions.",
      "Designed a real-time ETL pipeline with 100% data capture for business intelligence dashboards, saving Product Managers and Solutions Architects 20+ hours weekly.",
    ],
  },
  {
    title: "MLE Intern at Viridien",
    subtitle: "Jun to Sep 2024 · London, UK",
    points: [
      "Built an automated table extraction system combining LLMs with fine-tuned object detection models, achieving a 60% improvement in extraction accuracy and a 75% reduction in processing time.",
      "Designed and deployed an agentic AI system using Chain-of-Thought prompting to parse tabular data, reducing hallucinations and improving robustness across document types.",
    ],
  },
  {
    title: "Machine Learning Developer at Launchpad",
    subtitle: "Sep 2023 to present · Berkeley, CA",
    points: [
      "Engineered a legal database query system using LLM agents, reducing query resolution time by 90% and increasing client satisfaction by 25% for small-to-medium law firms.",
      "Implemented Retrieval Augmented Generation with vector databases, achieving a 10x improvement in query response time and generating $22,000 in revenue.",
    ],
  },
];

const research = [
  {
    title: "Research Assistant at MIT Database Group",
    subtitle: "Jun 2025 to present · Remote",
    points: [
      "Developed KramaBench, a benchmark framework for evaluating LLM agents on end-to-end data science pipelines and analytical workflows across diverse domains.",
      "Designed LLM agents and systematic validation pipelines to ensure benchmark accuracy across multiple difficulty levels.",
    ],
  },
  {
    title: "Research Intern at MIT CSAIL",
    subtitle: "Jun to Aug 2022 · Cambridge, MA",
    points: [
      "Designed and trained a generic Entity Resolution model for matching and deduplicating data across diverse domains, matching specialized models with 30% less training data and 25% less storage.",
    ],
  },
  {
    title: "Research Intern at Qatar Computing Research Institute",
    subtitle: "Jun to Aug 2021 · Doha, Qatar",
    points: [
      "Developed Sevi, an end-to-end Speech2Visualization system using a Transformer encoder-decoder architecture, enabling natural-language-driven data visualization with 85% accuracy.",
    ],
  },
];

const publications = [
  {
    title: "Generic Entity Resolution Models",
    venue: "Table Representation Learning Workshop @ NeurIPS 2022",
  },
  {
    title: "Sevi: Speech-to-Visualization through Neural Machine Translation",
    venue: "SIGMOD 2022 (demo)",
  },
];

const skills = [
  { label: "Languages", items: "Python, Java, C/C++, Go, SQL, JavaScript/TypeScript, Swift, React" },
  { label: "Machine Learning", items: "PyTorch, TensorFlow, Scikit-learn, Hugging Face Transformers, LangChain, OpenCV, Ray" },
  {
    label: "Data & Cloud",
    items:
      "Pandas, NumPy, Matplotlib, Jupyter, AWS (EC2, S3, Lambda, Athena, QuickSight, Bedrock, SageMaker), Docker, Kubernetes, Git, CI/CD, Terraform, Redis, PostgreSQL",
  },
];
---

<BaseLayout title="CV" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="B.S. in Electrical Engineering and Computer Sciences (EECS)"
      subtitle="University of California, Berkeley · Class of 2026 · GPA 4.0/4.0"
    >
      <span class="font-semibold">Relevant courses:</span> Data Structures and Algorithms, Discrete Mathematics and Probability,
      Computer Architecture, Efficient Algorithms, Computer Security, Machine Learning, Optimization Models, Databases,
      Networking, Computer Vision &amp; Computational Photography
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    {
      experience.map((job) => (
        <TimeLineElement title={job.title} subtitle={job.subtitle}>
          {job.points.length > 0 && (
            <ul class="list-disc ml-5 grid gap-1">
              {job.points.map((point) => <li>{point}</li>)}
            </ul>
          )}
        </TimeLineElement>
      ))
    }
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Research</div>
  </div>

  <div class="time-line-container mb-10">
    {
      research.map((job) => (
        <TimeLineElement title={job.title} subtitle={job.subtitle}>
          {job.points.length > 0 && (
            <ul class="list-disc ml-5 grid gap-1">
              {job.points.map((point) => <li>{point}</li>)}
            </ul>
          )}
        </TimeLineElement>
      ))
    }
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Publications</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    {
      publications.map((pub) => (
        <li>
          <span class="font-semibold">"{pub.title}"</span>. First author. <i>{pub.venue}</i>
        </li>
      ))
    }
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <div class="grid gap-2 mb-10">
    {
      skills.map((group) => (
        <div>
          <span class="font-semibold">{group.label}:</span> {group.items}
        </div>
      ))
    }
  </div>
</BaseLayout>

---
import Icon from "./Icon.astro";
import { LINKS } from "../config";

const { sideBarActiveItemID } = Astro.props;

const pages = [
  { id: "home", icon: "home", label: "Home", href: "/" },
  { id: "projects", icon: "projects", label: "Projects", href: "/projects" },
];
---

<aside class="sidebar" id="sidebar" aria-label="Site navigation">
  <nav class="nav-group">
    {
      pages.map((page) => (
        <a class="nav-item" href={page.href} aria-current={page.id === sideBarActiveItemID ? "page" : undefined}>
          <Icon name={page.icon} />
          {page.label}
        </a>
      ))
    }
  </nav>

  <div class="sidebar-section">Links</div>
  <nav class="nav-group" aria-label="External links">
    {
      LINKS.map((link) => {
        const external = !link.href.startsWith("mailto:");
        if (link.copy) {
          return (
            <button class="nav-item" type="button" data-copy={link.copy} data-href={link.href} title={link.copy}>
              <Icon name={link.icon} />
              <span data-copy-label>{link.label}</span>
            </button>
          );
        }
        return (
          <a class="nav-item" href={link.href} target={external ? "_blank" : undefined} rel={external ? "noreferrer" : undefined}>
            <Icon name={link.icon} />
            {link.label}
            {external && (
              <span class="nav-external">
                <Icon name="external" size={12} />
              </span>
            )}
          </a>
        );
      })
    }
  </nav>
</aside>

---
const { sideBarActiveItemID } = Astro.props;

const pages = [
  { id: "home", icon: "🏠", label: "Home", href: "/" },
  { id: "projects", icon: "📸", label: "Projects", href: "/projects" },
];

const links = [
  { icon: "📄", label: "CV", href: "/Jiawei_Tang_Resume.pdf" },
  { icon: "🐙", label: "GitHub", href: "https://github.com/jiaweitang22" },
  { icon: "💼", label: "LinkedIn", href: "https://www.linkedin.com/in/jiaweitang22" },
  { icon: "✉️", label: "Email", href: "mailto:jiaweitang22@gmail.com" },
];
---

<aside class="sidebar" aria-label="Site navigation">
  <a class="workspace" href="/">
    <img src="/profile.jpg" alt="" width="22" height="22" />
    Jiawei Tang
  </a>

  {
    pages.map((page) => (
      <a class="nav-item" href={page.href} aria-current={page.id === sideBarActiveItemID ? "page" : undefined}>
        <span class="nav-icon" aria-hidden="true">{page.icon}</span>
        {page.label}
      </a>
    ))
  }

  <div class="sidebar-section">Links</div>
  {
    links.map((link) => (
      <a class="nav-item" href={link.href} target={link.href.startsWith("mailto:") ? undefined : "_blank"} rel="noreferrer">
        <span class="nav-icon" aria-hidden="true">{link.icon}</span>
        {link.label}
        {!link.href.startsWith("mailto:") && <span class="nav-external" aria-hidden="true">↗</span>}
      </a>
    ))
  }
</aside>
